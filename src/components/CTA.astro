---
interface Props {
  title: string;
  description: string;
  buttonText: string;
  buttonHref?: string;
}

const { title, description, buttonText, buttonHref = "#" } = Astro.props;
---

<section class="py-16 md:py-24">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      class="bg-white dark:bg-background-dark/70 border border-border-light dark:border-border-dark rounded-xl p-8 md:p-12 text-center"
    >
      <h2 class="text-4xl font-bold tracking-tighter">{title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-subtext-light dark:text-subtext-dark">
        {description}
      </p>
      <div class="mt-8 flex items-center justify-center gap-x-6">
        <a
          href={buttonHref}
          class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-12 px-6 bg-primary text-white text-base font-semibold leading-normal tracking-tight hover:bg-primary/90 transition-colors duration-300"
        >
          <span class="truncate">{buttonText}</span>
        </a>
      </div>
    </div>
  </div>
</section>
