---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLangFromUrl, useTranslations } from '../i18n/translations';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

// Get base path without language prefix
const basePath = currentPath.replace(/^\/(id|en)/, '') || '/';
const langPrefix = `/${lang}`;
---

<header class="sticky top-4 z-50 px-4">
  <div class="max-w-6xl mx-auto">
    <div
      class="flex items-center justify-between whitespace-nowrap bg-background-dark/80 dark:bg-background-light/5 text-text-dark dark:text-text-dark backdrop-blur-lg rounded-full px-6 py-3 shadow-lg"
    >
      <div class="flex items-center gap-3 text-white">
        <div class="size-6 text-white">
          <svg fill="none" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
            <g clip-path="url(#clip0_6_535)">
              <path
                clip-rule="evenodd"
                d="M47.2426 24L24 47.2426L0.757355 24L24 0.757355L47.2426 24ZM12.2426 21H35.7574L24 9.24264L12.2426 21Z"
                fill="currentColor"
                fill-rule="evenodd"></path>
            </g>
            <defs>
              <clipPath id="clip0_6_535">
                <rect fill="white" height="48" width="48"></rect>
              </clipPath>
            </defs>
          </svg>
        </div>
        <h2 class="text-base font-semibold tracking-[-0.01em]">ConsultIT</h2>
      </div>
      <div class="hidden md:flex flex-1 justify-center gap-8">
        <div class="flex items-center gap-6">
          <a
            class:list={[
              "text-sm font-medium transition-colors",
              basePath === "/" ? "text-text-dark" : "text-text-dark/70 hover:text-text-dark"
            ]}
            href={`${langPrefix}/`}>{t('nav.home')}</a>
          <a
            class:list={[
              "text-sm font-medium transition-colors",
              basePath.startsWith("/services") ? "text-text-dark" : "text-text-dark/70 hover:text-text-dark"
            ]}
            href={`${langPrefix}/services`}>{t('nav.services')}</a>
          <a
            class:list={[
              "text-sm font-medium transition-colors",
              basePath.startsWith("/about-us") ? "text-text-dark" : "text-text-dark/70 hover:text-text-dark"
            ]}
            href={`${langPrefix}/about-us`}>{t('nav.about')}</a>
          <a
            class:list={[
              "text-sm font-medium transition-colors",
              basePath.startsWith("/cases") || basePath.startsWith("/show-case") ? "text-text-dark" : "text-text-dark/70 hover:text-text-dark"
            ]}
            href={`${langPrefix}/cases`}>{t('nav.cases')}</a>
          <a
            class:list={[
              "text-sm font-medium transition-colors",
              basePath.startsWith("/contact-us") ? "text-text-dark" : "text-text-dark/70 hover:text-text-dark"
            ]}
            href={`${langPrefix}/contact-us`}>{t('nav.contact')}</a>
        </div>
      </div>

      <div class="hidden md:flex items-center gap-2">
        <LanguageSwitcher />
        <button
          class="flex min-w-[36px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-9 w-9 bg-transparent hover:bg-white/10 text-white transition-colors"
        >
          <span class="material-symbols-outlined text-xl">search</span>
        </button>
        <button
          class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-9 px-4 bg-white text-black text-sm font-medium leading-normal hover:bg-neutral-200 transition-colors"
        >
          <span class="truncate">{t('nav.getQuote')}</span>
        </button>
      </div>
      <div class="md:hidden">
        <button id="mobile-menu-button" class="text-text-dark hover:text-white transition-colors">
          <span class="material-symbols-outlined">menu</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Elegant Sidebar Menu -->
  <div id="mobile-menu" class="fixed inset-0 z-50 md:hidden pointer-events-none">
    <!-- Backdrop -->
    <div id="mobile-menu-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>
    
    <!-- Sidebar Panel -->
    <div id="mobile-menu-panel" class="absolute left-0 top-0 bottom-0 w-80 max-w-[85vw] bg-white dark:bg-background-dark shadow-2xl transform -translate-x-full transition-transform duration-300 ease-out flex flex-col">
      <!-- Header -->
      <div class="flex items-center justify-between p-6 border-b border-border-light dark:border-border-dark">
        <div class="flex items-center gap-3">
          <div class="size-6 text-primary">
            <svg fill="currentColor" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
              <g clip-path="url(#clip0_6_535)">
                <path clip-rule="evenodd"
                  d="M47.2426 24L24 47.2426L0.757355 24L24 0.757355L47.2426 24ZM12.2426 21H35.7574L24 9.24264L12.2426 21Z"
                  fill="currentColor" fill-rule="evenodd"></path>
              </g>
              <defs>
                <clipPath id="clip0_6_535">
                  <rect fill="white" height="48" width="48"></rect>
                </clipPath>
              </defs>
            </svg>
          </div>
          <h2 class="text-base font-semibold">ConsultIT</h2>
        </div>
        <button id="mobile-menu-close" class="w-9 h-9 flex items-center justify-center rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
          <span class="material-symbols-outlined text-xl">close</span>
        </button>
      </div>

      <!-- Content -->
      <div class="flex-1 overflow-y-auto">
        <div class="p-6 space-y-8">
          <!-- Navigation -->
          <nav class="space-y-1">
            <a
              class:list={[
                "flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium transition-colors",
                basePath === "/" 
                  ? "bg-primary text-white" 
                  : "text-text-light dark:text-text-dark hover:bg-gray-100 dark:hover:bg-gray-800"
              ]}
              href={`${langPrefix}/`}
            >
              <span>{t('nav.home')}</span>
            </a>
            <a
              class:list={[
                "flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium transition-colors",
                basePath.startsWith("/services") 
                  ? "bg-primary text-white" 
                  : "text-text-light dark:text-text-dark hover:bg-gray-100 dark:hover:bg-gray-800"
              ]}
              href={`${langPrefix}/services`}
            >
              <span>{t('nav.services')}</span>
            </a>
            <a
              class:list={[
                "flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium transition-colors",
                basePath.startsWith("/about-us") 
                  ? "bg-primary text-white" 
                  : "text-text-light dark:text-text-dark hover:bg-gray-100 dark:hover:bg-gray-800"
              ]}
              href={`${langPrefix}/about-us`}
            >
              <span>{t('nav.about')}</span>
            </a>
            <a
              class:list={[
                "flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium transition-colors",
                basePath.startsWith("/cases") || basePath.startsWith("/show-case") 
                  ? "bg-primary text-white" 
                  : "text-text-light dark:text-text-dark hover:bg-gray-100 dark:hover:bg-gray-800"
              ]}
              href={`${langPrefix}/cases`}
            >
              <span>{t('nav.cases')}</span>
            </a>
            <a
              class:list={[
                "flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium transition-colors",
                basePath.startsWith("/contact-us") 
                  ? "bg-primary text-white" 
                  : "text-text-light dark:text-text-dark hover:bg-gray-100 dark:hover:bg-gray-800"
              ]}
              href={`${langPrefix}/contact-us`}
            >
              <span>{t('nav.contact')}</span>
            </a>
          </nav>

          <!-- Language Switcher -->
          <div>
            <p class="text-xs font-semibold text-subtext-light dark:text-subtext-dark uppercase tracking-wider mb-3">Language</p>
            <div class="flex gap-2">
              <a
                href={`/id${basePath}`}
                class:list={[
                  "flex-1 px-3 py-2 rounded-lg text-center text-sm font-medium transition-colors",
                  lang === 'id' 
                    ? "bg-primary text-white" 
                    : "bg-gray-100 dark:bg-gray-800 text-text-light dark:text-text-dark hover:bg-gray-200 dark:hover:bg-gray-700"
                ]}
              >
                ID
              </a>
              <a
                href={`/en${basePath}`}
                class:list={[
                  "flex-1 px-3 py-2 rounded-lg text-center text-sm font-medium transition-colors",
                  lang === 'en' 
                    ? "bg-primary text-white" 
                    : "bg-gray-100 dark:bg-gray-800 text-text-light dark:text-text-dark hover:bg-gray-200 dark:hover:bg-gray-700"
                ]}
              >
                EN
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Footer -->
      <div class="p-6 border-t border-border-light dark:border-border-dark">
        <button class="w-full px-4 py-3 bg-primary text-white rounded-lg text-sm font-semibold hover:bg-primary/90 transition-colors">
          {t('nav.getQuote')}
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const menuButton = document.getElementById('mobile-menu-button');
    const closeButton = document.getElementById('mobile-menu-close');
    const mobileMenu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const panel = document.getElementById('mobile-menu-panel');

    function openMenu() {
      if (mobileMenu && backdrop && panel) {
        mobileMenu.classList.remove('pointer-events-none');
        mobileMenu.classList.add('pointer-events-auto');
        
        // Trigger reflow
        backdrop.offsetHeight;
        panel.offsetHeight;
        
        backdrop.classList.remove('opacity-0');
        backdrop.classList.add('opacity-100');
        panel.classList.remove('-translate-x-full');
        panel.classList.add('translate-x-0');
        
        document.body.style.overflow = 'hidden';
      }
    }

    function closeMenu() {
      if (mobileMenu && backdrop && panel) {
        backdrop.classList.remove('opacity-100');
        backdrop.classList.add('opacity-0');
        panel.classList.remove('translate-x-0');
        panel.classList.add('-translate-x-full');
        
        setTimeout(() => {
          mobileMenu.classList.remove('pointer-events-auto');
          mobileMenu.classList.add('pointer-events-none');
        }, 300);
        
        document.body.style.overflow = '';
      }
    }

    menuButton?.addEventListener('click', openMenu);
    closeButton?.addEventListener('click', closeMenu);
    backdrop?.addEventListener('click', closeMenu);

    // Close on navigation
    const mobileLinks = document.querySelectorAll('#mobile-menu-panel a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        setTimeout(closeMenu, 150);
      });
    });

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMenu();
      }
    });
  });
</script>
