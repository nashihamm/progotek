---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import ServiceSchema from "../../components/ServiceSchema.astro";
import FAQSchema from "../../components/FAQSchema.astro";
import { useTranslations } from '../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'id' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang as 'id' | 'en');

const services = [
  {
    title: "Konsultasi & Strategi Web",
    description:
      "Kami membantu Anda merancang arah terbaik untuk website, landing page, dan web-app. Mulai dari analisis kebutuhan, arsitektur sistem, hingga rekomendasi teknologi yang tepat.",
    features: [
      "Analisis Kebutuhan Bisnis",
      "Strategi Website & Web-App",
      "Arsitektur Sistem Modern"
    ],
    image: "https://images.unsplash.com/photo-1544108191-2f7b533b37b0?q=80&w=600&auto=format&fit=crop",
    isOpen: true,
  },
  {
    title: "Pembuatan Landing Page Profesional",
    description:
      "Tingkatkan branding dan konversi dengan landing page cepat, modern, dan dirancang secara strategis untuk bisnis Anda.",
    features: [
      "Desain Modern & Clean",
      "Optimasi Kecepatan",
      "Copywriting Konversi"
    ],
    image: "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?q=80&w=600&auto=format&fit=crop",
  },
  {
    title: "Pengembangan Website Bisnis",
    description:
      "Bangun website profesional yang responsif dan mudah dikelola. Cocok untuk company profile, portofolio, personal branding, atau website bisnis lainnya.",
    features: [
      "Website Modern & Responsive",
      "Integrasi Form & API",
      "SEO On-Page Dasar"
    ],
    image: "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=600&auto=format&fit=crop",
  },
  {
    title: "Pengembangan Web-App Kustom",
    description:
      "Kami membangun web-app yang scalable, cepat, dan aman untuk kebutuhan bisnis Anda—mulai dari dashboard admin hingga aplikasi internal.",
    features: [
      "Web-App Kustom",
      "Dashboard Admin",
      "Integrasi API & Sistem"
    ],
    image: "https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=600&auto=format&fit=crop",
  }
];

// Service schema data
const serviceSchemaData = services.map(service => ({
  name: service.title,
  description: service.description,
  url: `https://progotek.pages.dev/${lang}/services#${service.title.toLowerCase().replace(/\s+/g, '-')}`,
  image: service.image
}));

// FAQ data for rich snippets
const faqs = lang === 'id' ? [
  {
    question: "Berapa lama waktu yang dibutuhkan untuk membuat website?",
    answer: "Waktu pengembangan bervariasi tergantung kompleksitas proyek. Landing page sederhana dapat selesai dalam 1-2 minggu, sementara website bisnis kompleks atau web-app kustom membutuhkan 4-12 minggu. Kami akan memberikan timeline yang jelas setelah analisis kebutuhan awal."
  },
  {
    question: "Apakah website yang dibuat sudah SEO-friendly?",
    answer: "Ya, semua website yang kami buat sudah dioptimasi untuk SEO on-page dasar, termasuk struktur HTML semantik, meta tags, kecepatan loading, dan mobile responsiveness. Untuk strategi SEO yang lebih komprehensif, kami juga menyediakan layanan konsultasi SEO terpisah."
  },
  {
    question: "Apakah saya bisa mengelola konten website sendiri?",
    answer: "Tentu! Kami dapat mengintegrasikan CMS (Content Management System) yang user-friendly sehingga Anda dapat mengelola konten website dengan mudah tanpa perlu coding. Kami juga menyediakan training dan dokumentasi lengkap."
  },
  {
    question: "Apakah ada garansi atau support setelah website selesai?",
    answer: "Ya, kami menyediakan garansi bug-fix selama 30 hari setelah launch. Untuk maintenance dan support berkelanjutan, kami menawarkan paket maintenance bulanan yang mencakup update, backup, monitoring, dan technical support."
  }
] : [
  {
    question: "How long does it take to build a website?",
    answer: "Development time varies depending on project complexity. A simple landing page can be completed in 1-2 weeks, while complex business websites or custom web-apps require 4-12 weeks. We'll provide a clear timeline after the initial requirements analysis."
  },
  {
    question: "Are the websites SEO-friendly?",
    answer: "Yes, all websites we build are optimized for basic on-page SEO, including semantic HTML structure, meta tags, loading speed, and mobile responsiveness. For more comprehensive SEO strategies, we also offer separate SEO consulting services."
  },
  {
    question: "Can I manage website content myself?",
    answer: "Absolutely! We can integrate a user-friendly CMS (Content Management System) so you can manage website content easily without coding. We also provide training and complete documentation."
  },
  {
    question: "Is there a warranty or support after the website is completed?",
    answer: "Yes, we provide a 30-day bug-fix warranty after launch. For ongoing maintenance and support, we offer monthly maintenance packages that include updates, backups, monitoring, and technical support."
  }
];

---

<Layout 
  title={lang === 'id' ? "Layanan Konsultasi IT & Pengembangan Web - ConsultIT" : "IT Consulting & Web Development Services - ConsultIT"}
  description={t('servicesPage.description')}
  lang={lang}
  keywords={['web development', 'landing page', 'web app', 'UI/UX design', 'digital strategy', 'IT consulting', 'website bisnis', 'konsultasi web']}
>
  <ServiceSchema services={serviceSchemaData} />
  <!-- <FAQSchema faqs={faqs} /> -->
  
  <main class="flex-1">
    <section class="py-24 sm:py-32">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-left">
          <p class="text-sm font-semibold uppercase tracking-wider text-primary mb-3">{t('services.label')}</p>
          <h1 class="text-5xl font-bold tracking-tight sm:text-6xl lg:text-7xl">
            {t('servicesPage.title')}
          </h1>
          <p class="mt-8 text-lg text-subtext-light dark:text-subtext-dark max-w-2xl">
            {t('servicesPage.description')}
          </p>
        </div>
      </div>
    </section>

    <section class="pb-24 sm:pb-32">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto flex flex-col gap-4" id="service-accordion">
          {
            services.map((service, index) => (
              <div
                class:list={[
                  "border-b border-border-light dark:border-border-dark py-8 service-item",
                  index === 0 ? "border-t open" : "",
                ]}
                data-index={index}
              >
                <div class="flex justify-between items-center cursor-pointer accordion-header">
                  <h3 class:list={[
                    "text-2xl sm:text-3xl font-medium transition-colors duration-300",
                    service.isOpen ? "text-primary" : "text-text-light dark:text-text-dark"
                  ]}>
                    {service.title}
                  </h3>
                  <div class:list={[
                    "w-10 h-10 rounded-full border flex items-center justify-center transition-all duration-300",
                    service.isOpen ? "border-primary rotate-45" : "border-border-light dark:border-border-dark"
                  ]}>
                    <span class:list={[
                      "material-symbols-outlined transition-colors duration-300",
                      service.isOpen ? "text-primary" : "text-text-light dark:text-text-dark"
                    ]}>
                      add
                    </span>
                  </div>
                </div>
                <div class:list={[
                  "grid transition-[grid-template-rows] duration-500 ease-in-out accordion-content",
                  service.isOpen ? "grid-rows-[1fr]" : "grid-rows-[0fr]"
                ]}>
                  <div class="overflow-hidden">
                    <div class="pt-8 grid md:grid-cols-3 gap-8">
                      <div class="md:col-span-2">
                        <p class="text-subtext-light dark:text-subtext-dark mb-6">
                          {service.description}
                        </p>
                        <h4 class="font-bold text-text-light dark:text-text-dark mb-4">
                          {t('servicesPage.keyFeatures')}
                        </h4>
                        <ul class="space-y-3">
                          {service.features.map((feature) => (
                            <li class="flex items-start">
                              <span class="material-symbols-outlined text-primary mr-3 mt-1 text-xl">
                                check_circle
                              </span>
                              <span class="text-subtext-light dark:text-subtext-dark">
                                {feature}
                              </span>
                            </li>
                          ))}
                        </ul>
                      </div>
                      <div class="space-y-4">
                        <div
                          class="aspect-video w-full rounded-lg bg-cover bg-center"
                          style={`background-image: url('${service.image}')`}
                        />
                        <button class="w-full min-w-[84px] cursor-pointer inline-flex items-center justify-center overflow-hidden rounded-md h-10 px-4 bg-primary/10 text-primary text-sm font-bold leading-normal tracking-[0.015em] transition-colors hover:bg-primary/20">
                          <span class="truncate">{t('services.learnMore')}</span>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const accordion = document.getElementById('service-accordion');
        if (!accordion) return;

        const items = accordion.querySelectorAll('.service-item');
        
        items.forEach((item) => {
          const header = item.querySelector('.accordion-header');
          const content = item.querySelector('.accordion-content');
          const title = item.querySelector('h3');
          const iconContainer = item.querySelector('.w-10');
          const icon = iconContainer?.querySelector('.material-symbols-outlined');
          
          if (!header || !content || !title || !iconContainer || !icon) return;
          
          header.addEventListener('click', () => {
            const isOpen = item.classList.contains('open');
            
            // Close all other items
            items.forEach((otherItem) => {
              if (otherItem !== item) {
                otherItem.classList.remove('open');
                const otherContent = otherItem.querySelector('.accordion-content');
                const otherTitle = otherItem.querySelector('h3');
                const otherIconContainer = otherItem.querySelector('.w-10');
                const otherIcon = otherIconContainer?.querySelector('.material-symbols-outlined');
                
                if (otherContent) {
                  otherContent.classList.remove('grid-rows-[1fr]');
                  otherContent.classList.add('grid-rows-[0fr]');
                }
                if (otherTitle) {
                  otherTitle.classList.remove('text-primary');
                  otherTitle.classList.add('text-text-light', 'dark:text-text-dark');
                }
                if (otherIconContainer) {
                  otherIconContainer.classList.remove('border-primary', 'rotate-45');
                  otherIconContainer.classList.add('border-border-light', 'dark:border-border-dark');
                }
                if (otherIcon) {
                  otherIcon.classList.remove('text-primary');
                  otherIcon.classList.add('text-text-light', 'dark:text-text-dark');
                }
              }
            });
            
            // Toggle current item
            if (isOpen) {
              item.classList.remove('open');
              content.classList.remove('grid-rows-[1fr]');
              content.classList.add('grid-rows-[0fr]');
              title.classList.remove('text-primary');
              title.classList.add('text-text-light', 'dark:text-text-dark');
              iconContainer.classList.remove('border-primary', 'rotate-45');
              iconContainer.classList.add('border-border-light', 'dark:border-border-dark');
              icon.classList.remove('text-primary');
              icon.classList.add('text-text-light', 'dark:text-text-dark');
            } else {
              item.classList.add('open');
              content.classList.remove('grid-rows-[0fr]');
              content.classList.add('grid-rows-[1fr]');
              title.classList.remove('text-text-light', 'dark:text-text-dark');
              title.classList.add('text-primary');
              iconContainer.classList.remove('border-border-light', 'dark:border-border-dark');
              iconContainer.classList.add('border-primary', 'rotate-45');
              icon.classList.remove('text-text-light', 'dark:text-text-dark');
              icon.classList.add('text-primary');
            }
          });
        });
      });
    </script>

    <!-- FAQ Section -->
    <section class="py-24 sm:py-32 bg-background-light dark:bg-background-dark">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <p class="text-sm font-semibold uppercase tracking-wider text-primary mb-3">
            {lang === 'id' ? 'FAQ' : 'FAQ'}
          </p>
          <h2 class="text-4xl font-bold tracking-tight sm:text-5xl mb-4">
            {lang === 'id' ? 'Pertanyaan yang Sering Diajukan' : 'Frequently Asked Questions'}
          </h2>
          <p class="text-lg text-subtext-light dark:text-subtext-dark max-w-2xl mx-auto">
            {lang === 'id' ? 'Temukan jawaban untuk pertanyaan umum tentang layanan kami' : 'Find answers to common questions about our services'}
          </p>
        </div>
        
        <div class="space-y-3">
          {faqs.map((faq, index) => (
            <details class="group bg-card-light dark:bg-card-dark rounded-xl border border-border-light dark:border-border-dark overflow-hidden transition-all hover:border-primary/30">
              <summary class="cursor-pointer px-6 py-5 list-none flex items-center justify-between gap-4 select-none">
                <div class="flex items-start gap-4 flex-1">
                  <div class="flex-shrink-0 w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-sm mt-0.5">
                    {index + 1}
                  </div>
                  <h3 class="font-semibold text-lg text-text-light dark:text-text-dark group-hover:text-primary transition-colors flex-1">
                    {faq.question}
                  </h3>
                </div>
                <div class="flex-shrink-0 w-8 h-8 rounded-full border-2 border-border-light dark:border-border-dark group-hover:border-primary flex items-center justify-center transition-all">
                  <span class="material-symbols-outlined text-xl transition-transform duration-300 group-open:rotate-180 text-subtext-light dark:text-subtext-dark group-hover:text-primary">
                    expand_more
                  </span>
                </div>
              </summary>
              <div class="px-6 pb-5 pl-[4.5rem]">
                <p class="text-subtext-light dark:text-subtext-dark leading-relaxed">
                  {faq.answer}
                </p>
              </div>
            </details>
          ))}
        </div>
        
        <div class="mt-12 text-center">
          <p class="text-subtext-light dark:text-subtext-dark mb-4">
            {lang === 'id' ? 'Masih ada pertanyaan lain?' : 'Still have questions?'}
          </p>
          <a 
            href={`/${lang}/contact-us`}
            class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white font-semibold rounded-lg hover:bg-primary/90 transition-colors"
          >
            <span>{lang === 'id' ? 'Hubungi Kami' : 'Contact Us'}</span>
            <span class="material-symbols-outlined text-xl">arrow_forward</span>
          </a>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-24 sm:py-32 bg-gradient-to-br from-primary/5 via-background-light dark:via-background-dark to-background-light dark:to-background-dark">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
          <div class="text-left">
            <p class="text-sm font-semibold uppercase tracking-wider text-primary mb-3">
              {lang === 'id' ? 'Mulai Proyek Anda' : 'Start Your Project'}
            </p>
            <h2 class="text-4xl font-bold tracking-tight sm:text-5xl mb-6">
              {t('servicesPage.demoTitle')}
            </h2>
            <p class="text-lg text-subtext-light dark:text-subtext-dark max-w-lg mb-8">
              {t('servicesPage.demoDesc')}
            </p>
            
            <div class="space-y-4">
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0 w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center mt-0.5">
                  <span class="material-symbols-outlined text-primary text-sm">check</span>
                </div>
                <p class="text-subtext-light dark:text-subtext-dark">
                  {lang === 'id' ? 'Konsultasi gratis untuk analisis kebutuhan' : 'Free consultation for requirements analysis'}
                </p>
              </div>
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0 w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center mt-0.5">
                  <span class="material-symbols-outlined text-primary text-sm">check</span>
                </div>
                <p class="text-subtext-light dark:text-subtext-dark">
                  {lang === 'id' ? 'Timeline dan estimasi biaya yang jelas' : 'Clear timeline and cost estimation'}
                </p>
              </div>
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0 w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center mt-0.5">
                  <span class="material-symbols-outlined text-primary text-sm">check</span>
                </div>
                <p class="text-subtext-light dark:text-subtext-dark">
                  {lang === 'id' ? 'Demo personal sesuai kebutuhan bisnis Anda' : 'Personalized demo for your business needs'}
                </p>
              </div>
            </div>
          </div>
          
          <div class="bg-card-light dark:bg-card-dark p-8 sm:p-10 rounded-2xl shadow-xl border border-border-light dark:border-border-dark">
            <form action="#" class="space-y-5" method="POST">
              <div>
                <label class="block text-sm font-semibold mb-2 text-text-light dark:text-text-dark" for="nama-lengkap">
                  {t('servicesPage.fullName')}
                </label>
                <input
                  class="block w-full rounded-lg border-0 bg-background-light dark:bg-background-dark py-3 px-4 text-text-light dark:text-text-dark placeholder:text-subtext-light dark:placeholder:text-subtext-dark shadow-sm ring-1 ring-inset ring-border-light dark:ring-border-dark focus:ring-2 focus:ring-primary transition-shadow"
                  id="nama-lengkap"
                  name="nama-lengkap"
                  type="text"
                  placeholder={lang === 'id' ? 'Nama lengkap Anda' : 'Your full name'}
                  required
                />
              </div>
              
              <div>
                <label class="block text-sm font-semibold mb-2 text-text-light dark:text-text-dark" for="email">
                  {t('servicesPage.companyEmail')}
                </label>
                <input
                  class="block w-full rounded-lg border-0 bg-background-light dark:bg-background-dark py-3 px-4 text-text-light dark:text-text-dark placeholder:text-subtext-light dark:placeholder:text-subtext-dark shadow-sm ring-1 ring-inset ring-border-light dark:ring-border-dark focus:ring-2 focus:ring-primary transition-shadow"
                  id="email"
                  name="email"
                  type="email"
                  placeholder={lang === 'id' ? 'email@perusahaan.com' : 'email@company.com'}
                  required
                />
              </div>
              
              <div>
                <label class="block text-sm font-semibold mb-2 text-text-light dark:text-text-dark" for="layanan">
                  {t('servicesPage.serviceInterest')}
                </label>
                <select
                  class="block w-full rounded-lg border-0 bg-background-light dark:bg-background-dark py-3 px-4 text-text-light dark:text-text-dark shadow-sm ring-1 ring-inset ring-border-light dark:ring-border-dark focus:ring-2 focus:ring-primary transition-shadow cursor-pointer"
                  id="layanan"
                  name="layanan"
                  required
                >
                  <option value="">{lang === 'id' ? 'Pilih layanan...' : 'Select service...'}</option>
                  {services.map((service) => <option value={service.title}>{service.title}</option>)}
                </select>
              </div>
              
              <button
                class="flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-6 py-3.5 text-base font-bold text-white hover:bg-primary/90 transition-all hover:shadow-lg hover:shadow-primary/20 active:scale-[0.98]"
                type="submit"
              >
                <span>{t('servicesPage.submitDemo')}</span>
                <span class="material-symbols-outlined text-xl">send</span>
              </button>
              
              <p class="text-xs text-center text-subtext-light dark:text-subtext-dark">
                {lang === 'id' 
                  ? 'Kami akan menghubungi Anda dalam 1x24 jam' 
                  : 'We will contact you within 24 hours'}
              </p>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
