---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import { useTranslations } from '../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'id' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const t = useTranslations(lang as 'id' | 'en');
---

<Layout title={`${t('contactPage.title')} - ConsultIT`}>
  <main class="flex-1">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
      <div class="text-center mb-16">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold leading-tight tracking-tight">
          Hubungi Kami
        </h1>
        <p class="text-subtext-light dark:text-subtext-dark text-lg font-normal leading-relaxed max-w-2xl mx-auto mt-6">
          Siap Memulai Proyek Anda? Kami di sini untuk membantu dan menjawab setiap pertanyaan yang
          Anda miliki. Kami menantikan kabar dari Anda.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
        <div class="flex flex-col gap-10 pt-2">
          <div class="flex items-start gap-4 group">
            <div
              class="text-primary flex items-center justify-center rounded-full bg-primary/5 dark:bg-primary/10 shrink-0 size-12 group-hover:bg-primary/10 dark:group-hover:bg-primary/20 transition-colors duration-300"
            >
              <span class="material-symbols-outlined">location_on</span>
            </div>
            <div class="flex flex-col justify-center">
              <p class="text-lg font-semibold leading-normal">Alamat Kantor</p>
              <p class="text-subtext-light dark:text-subtext-dark text-base font-normal leading-relaxed">
                123 Tech Avenue, Suite 100, Silicon Valley, CA 94043
              </p>
              <p class="text-subtext-light dark:text-subtext-dark text-base font-normal leading-relaxed mt-1">
                Jam Operasional: Senin - Jumat, 09:00 - 17:00
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4 group">
            <div
              class="text-primary flex items-center justify-center rounded-full bg-primary/5 dark:bg-primary/10 shrink-0 size-12 group-hover:bg-primary/10 dark:group-hover:bg-primary/20 transition-colors duration-300"
            >
              <span class="material-symbols-outlined">mail</span>
            </div>
            <div class="flex flex-col justify-center">
              <p class="text-lg font-semibold leading-normal">Email Kami</p>
              <p class="text-subtext-light dark:text-subtext-dark text-base font-normal leading-relaxed">
                contact@consultit.com
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4 group">
            <div
              class="text-primary flex items-center justify-center rounded-full bg-primary/5 dark:bg-primary/10 shrink-0 size-12 group-hover:bg-primary/10 dark:group-hover:bg-primary/20 transition-colors duration-300"
            >
              <span class="material-symbols-outlined">call</span>
            </div>
            <div class="flex flex-col justify-center">
              <p class="text-lg font-semibold leading-normal">Telepon</p>
              <p class="text-subtext-light dark:text-subtext-dark text-base font-normal leading-relaxed">
                +1 (555) 123-4567
              </p>
            </div>
          </div>
        </div>

        <div
          class="bg-white dark:bg-background-dark/50 rounded-xl p-8 border border-border-light dark:border-border-dark"
        >
          <h3 class="text-2xl font-bold mb-8">Kirimkan Kami Pesan</h3>
          <form action="#" class="space-y-6" method="POST">
            <div>
              <label class="block text-sm font-medium mb-2" for="full-name">Nama Lengkap</label>
              <input
                class="block w-full rounded-lg border-border-light dark:border-border-dark bg-background-light dark:bg-background-dark/60 py-3 px-4 focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-300"
                id="full-name"
                name="full-name"
                placeholder="John Doe"
                type="text"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2" for="email">Email</label>
              <input
                class="block w-full rounded-lg border-border-light dark:border-border-dark bg-background-light dark:bg-background-dark/60 py-3 px-4 focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-300"
                id="email"
                name="email"
                placeholder="you@example.com"
                type="email"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2" for="subject">Subjek</label>
              <input
                class="block w-full rounded-lg border-border-light dark:border-border-dark bg-background-light dark:bg-background-dark/60 py-3 px-4 focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-300"
                id="subject"
                name="subject"
                placeholder="Diskusi Proyek Baru"
                type="text"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2" for="message">Pesan Anda</label>
              <textarea
                class="block w-full rounded-lg border-border-light dark:border-border-dark bg-background-light dark:bg-background-dark/60 py-3 px-4 focus:ring-2 focus:ring-primary/50 focus:border-primary transition-all duration-300"
                id="message"
                name="message"
                placeholder="Jelaskan kebutuhan Anda di sini..."
                rows="4"></textarea>
            </div>
            <div>
              <button
                class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg text-base font-semibold text-white bg-primary hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-all duration-300 ease-in-out"
                type="submit"
              >
                Kirim Pesan
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
