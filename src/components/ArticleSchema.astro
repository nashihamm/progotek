---
interface Props {
  title: string;
  description: string;
  image: string;
  datePublished: string;
  dateModified?: string;
  author?: string;
  keywords?: string[];
}

const { 
  title, 
  description, 
  image, 
  datePublished, 
  dateModified = datePublished,
  author = "ConsultIT Team",
  keywords = []
} = Astro.props;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "image": {
    "@type": "ImageObject",
    "url": image,
    "width": 1200,
    "height": 630
  },
  "datePublished": datePublished,
  "dateModified": dateModified,
  "author": {
    "@type": "Person",
    "name": author,
    "url": "https://progotek.pages.dev/about-us"
  },
  "publisher": {
    "@type": "Organization",
    "name": "ConsultIT - TechCorp",
    "logo": {
      "@type": "ImageObject",
      "url": "https://progotek.pages.dev/logo.png",
      "width": 600,
      "height": 60
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": Astro.url.href
  },
  ...(keywords.length > 0 && { "keywords": keywords.join(", ") })
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
