---
interface Step {
  name: string;
  text: string;
  image?: string;
  url?: string;
}

interface Props {
  name: string;
  description: string;
  totalTime?: string;
  steps: Step[];
  image?: string;
}

const { name, description, totalTime, steps, image } = Astro.props;

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": name,
  "description": description,
  ...(totalTime && { "totalTime": totalTime }),
  ...(image && { 
    "image": {
      "@type": "ImageObject",
      "url": image,
      "width": 1200,
      "height": 630
    }
  }),
  "step": steps.map((step, index) => ({
    "@type": "HowToStep",
    "position": index + 1,
    "name": step.name,
    "text": step.text,
    ...(step.image && {
      "image": {
        "@type": "ImageObject",
        "url": step.image
      }
    }),
    ...(step.url && { "url": step.url })
  }))
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(howToSchema)} />
